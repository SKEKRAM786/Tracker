# MongoDB Connection
# For local development: mongodb://127.0.0.1:27017/jobtracker
# For Vercel deployment: mongodb+srv://<username>:<password>@cluster.mongodb.net/jobtracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jobtracker

# Secret for signing session cookies
JWT_SECRET=jobtracker-super-secret-key-2026-production

# (Optional) Supabase (if you prefer Supabase Postgres instead of MongoDB)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
